# Database — use ONE Supabase project for local dev and production.
# Next.js loads .env.local over .env; keep DATABASE_URL identical in both.
# Local/migrations: direct Supabase URL (port 5432).
# Netlify production: set DATABASE_URL to the pooler (6543) AND DIRECT_URL to direct (5432).
# The app uses DIRECT_URL on Netlify for reliable Prisma reads.
DATABASE_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# SMS Pasal (phone OTP login for mobile app)
# Dashboard API: GET https://sms.smspasal.com/smsapi/index?key=&contacts=&senderid=&msg=&responsetype=json
SMS_PASAL_API_KEY="your-sms-pasal-api-key"
SMS_PASAL_SENDER_ID="SMSBit"
SMS_PASAL_API_URL="https://sms.smspasal.com/smsapi/index"

# Truecaller OAuth (sandbox Client ID used as fallback in lib/truecaller.ts)
TRUECALLER_CLIENT_ID="rlhxfbctueeryexcclhw7wnpikukvkbcnnqdbzjt0py"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing one
# 2. Go to "Credentials" and create "OAuth 2.0 Client ID"
# 3. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 4. For production, add: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Redis (Optional - for caching)
REDIS_URL="redis://localhost:6379"

# Push notifications (Firebase Cloud Messaging)
# Firebase Console → Project settings → Service accounts → Generate new private key
# Prefer base64 of the JSON file (avoids quote/newline issues on Vercel):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('sa.json')).toString('base64'))"
# Or paste minified JSON as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional: protect /api/cron/reminders (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me-cron-secret"
# How many days ahead to send birthday/anniversary reminders (default 3)
REMINDER_DAYS_AHEAD="3"

# Google Maps API (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
# Server-side Geocoding API key. Strongly recommended because the public key above
# is usually restricted to Android/iOS apps and will be denied from Vercel's servers.
GOOGLE_GEOCODING_API_KEY="your-server-side-geocoding-api-key"

# Cloudflare Workers AI (AI gifting assistant)
# Get your Account ID from https://dash.cloudflare.com (right sidebar of any domain).
# Get an API token from https://dash.cloudflare.com/profile/api-tokens with Permissions:
#   Account > Workers AI > Edit
CF_ACCOUNT_ID="your-cloudflare-account-id"
CF_API_TOKEN="your-cloudflare-api-token"

# Cloudflare R2 (Product Image Uploads)
# Bucket URL format: https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_BUCKET_URL="https://f943d5f656be301e2c766ac590d8910b.r2.cloudflarestorage.com/chapter"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Optional overrides:
# R2_ENDPOINT="https://f943d5f656be301e2c766ac590d8910b.r2.cloudflarestorage.com"
# R2_BUCKET_NAME="chapter"
# R2_PUBLIC_BASE_URL="https://f943d5f656be301e2c766ac590d8910b.r2.cloudflarestorage.com/chapter"

# Database backups → dedicated R2 bucket (npm run backup:r2)
# Created with: npx wrangler r2 bucket create upaharo-backups
R2_BACKUP_BUCKET_NAME="upaharo-backups"
# R2_BACKUP_PREFIX="backups"

# Stripe (test keys from Dashboard → Developers → API keys)
# Publishable key is safe for the client; secret key must stay server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# Checkout currency (lowercase ISO). Match your Stripe account / Dashboard.
STRIPE_CURRENCY="npr"
# Webhook endpoint URL (production / Netlify):
#   https://www.upaharo.com/api/payments/stripe/webhook
# Local: stripe listen --forward-to localhost:3000/api/payments/stripe/webhook
# Then paste the whsec_... signing secret here (and on Netlify env).
STRIPE_WEBHOOK_SECRET="whsec_..."

# Netlify production URLs (set on Netlify dashboard / npm run netlify:env)
# NEXTAUTH_URL="https://www.upaharo.com"
# NEXT_PUBLIC_APP_URL="https://www.upaharo.com"
