# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fnp_db"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing one
# 2. Go to "Credentials" and create "OAuth 2.0 Client ID"
# 3. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 4. For production, add: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Redis (Optional - for caching)
REDIS_URL="redis://localhost:6379"

# Google Maps API (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
# Server-side Geocoding API key. Strongly recommended because the public key above
# is usually restricted to Android/iOS apps and will be denied from Vercel's servers.
GOOGLE_GEOCODING_API_KEY="your-server-side-geocoding-api-key"

# Cloudflare R2 (Product Image Uploads)
# Bucket URL format: https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_BUCKET_URL="https://f943d5f656be301e2c766ac590d8910b.r2.cloudflarestorage.com/chapter"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Optional overrides:
# R2_ENDPOINT="https://f943d5f656be301e2c766ac590d8910b.r2.cloudflarestorage.com"
# R2_BUCKET_NAME="chapter"
# R2_PUBLIC_BASE_URL="https://f943d5f656be301e2c766ac590d8910b.r2.cloudflarestorage.com/chapter"
