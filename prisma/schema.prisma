generator client {
  provider      = "prisma-client-js"
  // native = local Windows/macOS; rhel-openssl-3.0.x = Netlify Functions (AWS Linux)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  phone             String?            @unique
  name              String
  password          String?
  role              UserRole           @default(CUSTOMER)
  image             String?
  emailVerified     DateTime?
  addresses         Address[]
  orders            Order[]
  giftRecipients    GiftRecipient[]
  seller            Seller?
  accounts          Account[]
  sessions          Session[]
  coupons           Coupon[]
  spinPlays         SpinPlay[]
  productViewEvents ProductViewEvent[]
  deviceTokens      DeviceToken[]
  notifications     AppNotification[]
  businessProfile   BusinessProfile?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([email])
  @@index([phone])
}

/// B2B wholesale business account (separate from retail browsing).
model BusinessProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopName])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // android | ios | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AppNotification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum NotificationType {
  ORDER_PLACED
  ORDER_UPDATE
  PAYMENT
  REMINDER
  PROMO
  GENERAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  street     String
  apartment  String?
  landmark   String?
  city       String
  state      String
  pincode    String
  latitude   Float
  longitude  Float
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@index([userId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  /// Soft background tint for the app/home when this banner is active (hex, e.g. #FFE0E8).
  bgColor   String?
  /// Up to 3 product IDs shown in the banner strip (takes priority over category).
  productIds String[] @default([])
  /// When set (and productIds empty), show up to 3 products from this category name.
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model Product {
  id                        String               @id @default(cuid())
  name                      String
  miniDescription           String?
  description               String
  category                  String
  price                     Float
  /// B2B / wholesale unit price for local businesses (null = not sold wholesale).
  wholesalePrice            Float?
  image                     String
  images                    String[]             @default([])
  variants                  Json[]               @default([])
  imageAlt                  String?
  isAvailable               Boolean              @default(true)
  showFoodTypeLabel         Boolean              @default(false)
  isVeg                     Boolean              @default(true)
  prepTime                  Int                  @default(15)
  tags                      String[]
  discount                  Float?               @default(0)
  sellerId                  String?
  seller                    Seller?              @relation(fields: [sellerId], references: [id])
  orderItems                OrderItem[]
  productViewEvents         ProductViewEvent[]
  sourceRecommendationRules RecommendationRule[] @relation("SourceProductRecommendationRules")
  targetRecommendationRules RecommendationRule[] @relation("TargetProductRecommendationRules")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@index([category])
  @@index([isAvailable])
  @@index([sellerId])
}

model Order {
  id                String           @id @default(cuid())
  orderNumber       String           @unique
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  items             OrderItem[]
  status            OrderStatus      @default(PENDING)
  addressId         String?
  address           Address?         @relation(fields: [addressId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  subtotal          Float
  deliveryFee       Float
  tax               Float
  discount          Float            @default(0)
  couponDiscount    Float            @default(0)
  couponId          String?
  coupon            Coupon?          @relation(fields: [couponId], references: [id])
  total             Float
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus    @default(PENDING)
  estimatedTime     Int
  placedAt          DateTime         @default(now())
  acceptedAt        DateTime?
  preparingAt       DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  /// Customer shares this code with the rider/admin to confirm delivery.
  deliveryOtp       String?
  deliveryOtpCreatedAt DateTime?
  trackingUpdates   Json[]           @default([])
  isGift            Boolean          @default(false)
  /// Wholesale / B2B order (separate from retail storefront cart).
  isWholesale       Boolean          @default(false)
  businessName      String?
  recipientId       String?
  recipient         GiftRecipient?   @relation(fields: [recipientId], references: [id])
  occasionId        String?
  occasion          Occasion?        @relation(fields: [occasionId], references: [id])
  giftWrapId        String?
  giftWrap          GiftWrap?        @relation(fields: [giftWrapId], references: [id])
  greetingMessage   String?
  senderName        String?
  showSenderName    Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([couponId])
  @@index([isGift])
  @@index([isWholesale])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponApplicability {
  ALL
  CATEGORIES
  PRODUCTS
}

model Coupon {
  id                   String                @id @default(cuid())
  code                 String                @unique
  description          String?
  type                 CouponType
  value                Float
  minOrderAmount       Float                 @default(0)
  maxDiscount          Float?
  usageLimit           Int?
  usedCount            Int                   @default(0)
  startAt              DateTime?
  endAt                DateTime?
  isActive             Boolean               @default(true)
  applicability        CouponApplicability   @default(ALL)
  applicableCategoryIds String[]             @default([])
  applicableProductIds  String[]             @default([])
  createdByUserId      String?
  createdBy            User?                 @relation(fields: [createdByUserId], references: [id])
  orders               Order[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([isActive])
  @@index([code])
  @@index([createdByUserId])
}

/// One promo roulette play (limits spins + links awarded coupon).
model SpinPlay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String?
  percent   Int
  playedAt  DateTime @default(now())

  @@index([userId, playedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model DeliveryPartner {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String   @unique
  password      String
  vehicleType   String
  vehicleNumber String
  isAvailable   Boolean  @default(true)
  currentLat    Float?
  currentLng    Float?
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isAvailable])
}

model Seller {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessAddress String
  gstin           String?   @unique
  phone           String
  email           String
  commission      Float     @default(15)
  bankAccountName String?
  bankAccountNo   String?
  ifscCode        String?
  panNumber       String?
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([isActive])
}

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY_PARTNER
  SELLER
}

model Category {
  id                  String               @id @default(cuid())
  name                String               @unique
  image               String
  type                CategoryType         @default(PRODUCT)
  parentId            String?
  parent              Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[]           @relation("CategoryHierarchy")
  recommendationRules RecommendationRule[] @relation("SourceCategoryRecommendationRules")
  isActive            Boolean              @default(true)
  /// Home header wash tint for this category, hex `#RRGGBB`.
  washColor           String?
  /// Mobile icon key (see ADMIN_CATEGORY_ICONS), e.g. `cake`.
  iconName            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([parentId])
  @@index([type])
}

enum CategoryType {
  PRODUCT
  RECIPIENT
  OCCASION
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum RecommendationScopeType {
  PRODUCT
  CATEGORY
}

enum RecommendationKind {
  RELATED
  ADDON
  COMBO
}

model GiftRecipient {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  relationship String
  birthDate    DateTime?
  anniversary  DateTime?
  interests    String[]
  notes        String?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model GiftWrap {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  price       Float
  image       String
  type        String
  isActive    Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())

  @@index([type])
}

model Occasion {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String
  description String
  icon        String
  isActive    Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
}

model AppSettings {
  id                          String   @id @default("default")
  siteName                    String   @default("Chapter Kurus")
  supportPhone                String?
  supportEmail                String?
  supportHours                String?
  supportMessage              String?
  deliveryEstimate            String   @default("Estimated delivery: 20-30 minutes")
  deliveryNote                String?
  announcementText            String?
  storeAddress                String?
  mapLatitude                 Float    @default(27.7172)
  mapLongitude                Float    @default(85.3240)
  homepageShowBanner          Boolean  @default(true)
  homepageShowTopCategories   Boolean  @default(true)
  homepageShowCategorySections Boolean @default(true)
  homepageShowOccasionTabs    Boolean  @default(true)
  homepageShowRecommendations Boolean  @default(true)
  homepageShowValueDeals      Boolean  @default(true)
  homepageShowSpinBanner      Boolean  @default(true)
  homepageRecommendationMode  String   @default("LATEST")
  homepageRecommendationTitle String?
  /// Ordered mobile home sections: `[{ id, title, subtitle, visible }]`.
  homeSectionLayout           Json?
  /// Mobile brand primary (buttons / accents), hex `#RRGGBB`.
  brandPrimary                String   @default("#8B5A2B")
  /// Mobile brand secondary (gold accents), hex `#RRGGBB`.
  brandSecondary              String   @default("#D4AF37")
  /// Home header soft wash fallback, hex `#RRGGBB`.
  headerWash                  String   @default("#F7F0E8")
  /// Scaffold / page background, hex `#RRGGBB`.
  pageBackground              String   @default("#FFFFFF")
  /// Primary text colour, hex `#RRGGBB`.
  textInk                     String   @default("#1F1F1F")
  /// Secondary / muted text colour, hex `#RRGGBB`.
  textMuted                   String   @default("#3E3E3E")
  /// Chip + image placeholder fill, hex `#RRGGBB`.
  surfaceSoft                 String   @default("#F4F4F5")
  /// Card / tile surface, hex `#RRGGBB`.
  cardBackground              String   @default("#FFFFFF")
  /// Card + input corner radius in logical pixels.
  cornerRadius                Int      @default(12)
  /// Button corner radius in logical pixels.
  buttonRadius                Int      @default(30)
  /// Spacing scale: COMPACT | COMFORTABLE | SPACIOUS.
  uiDensity                   String   @default("COMFORTABLE")
  /// Product grid columns on home / category tabs.
  productGridColumns          Int      @default(2)
  /// Product tile width-to-height ratio.
  productCardAspectRatio      Float    @default(0.68)
  productShowDiscountBadge    Boolean  @default(true)
  productShowCategoryLabel    Boolean  @default(false)
  /// Show the floating promo orb / Promo tab in the mobile bottom nav.
  showPromoTab                Boolean  @default(true)
  /// Promo orb flip text, e.g. `20% OFF`.
  promoOrbLabel               String   @default("20% OFF")
  navHomeLabel                String   @default("Home")
  navCategoriesLabel          String   @default("Categories")
  navTopPicksLabel            String   @default("Top picks")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model ProductViewEvent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  viewedAt  DateTime @default(now())

  @@index([productId])
  @@index([userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@index([viewedAt])
}

model RecommendationRule {
  id               String                  @id @default(cuid())
  scopeType        RecommendationScopeType
  sourceProductId  String?
  sourceProduct    Product?                @relation("SourceProductRecommendationRules", fields: [sourceProductId], references: [id], onDelete: Cascade)
  sourceCategoryId String?
  sourceCategory   Category?               @relation("SourceCategoryRecommendationRules", fields: [sourceCategoryId], references: [id], onDelete: Cascade)
  targetProductId  String
  targetProduct    Product                 @relation("TargetProductRecommendationRules", fields: [targetProductId], references: [id], onDelete: Cascade)
  kind             RecommendationKind
  position         Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([scopeType, sourceProductId, kind, position])
  @@index([scopeType, sourceCategoryId, kind, position])
  @@index([targetProductId])
}
