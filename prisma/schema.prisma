generator client {
  provider      = "prisma-client-js"
  // native = local Windows/macOS; rhel-openssl-3.0.x = Netlify Functions (AWS Linux)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  phone              String?             @unique
  name               String
  password           String?
  role               UserRole            @default(CUSTOMER)
  image              String?
  emailVerified      DateTime?
  addresses          Address[]
  orders             Order[]
  giftRecipients     GiftRecipient[]
  seller             Seller?
  deliveryPartner    DeliveryPartner?
  partnerAccess      PartnerAccess?
  accounts           Account[]
  sessions           Session[]
  coupons            Coupon[]
  spinPlays          SpinPlay[]
  promoGamePlays     PromoGamePlay[]
  productViewEvents  ProductViewEvent[]
  deviceTokens       DeviceToken[]
  notifications      AppNotification[]
  businessProfile    BusinessProfile?
  walletAccounts     WalletAccount[]
  walletTransactions WalletTransaction[]
  wishlistItems      WishlistItem[]
  trustedDevices    TrustedDevice[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([email])
  @@index([phone])
}

/// A customer-facing storefront. Catalog, settings, orders, and wallet are
/// scoped per store; user accounts are shared (same login across apps).
model Store {
  id                  String                 @id @default(cuid())
  slug                String                 @unique
  name                String
  isActive            Boolean                @default(true)
  products            Product[]
  categories          Category[]
  banners             Banner[]
  bannerSections      BannerSection[]
  miniBanners         MiniBanner[]
  coupons             Coupon[]
  giftWraps           GiftWrap[]
  occasions           Occasion[]
  appSettings         AppSettings?
  orders              Order[]
  walletAccounts      WalletAccount[]
  walletTransactions  WalletTransaction[]
  spinPlays           SpinPlay[]
  promoGamePlays      PromoGamePlay[]
  productViewEvents   ProductViewEvent[]
  recommendationRules RecommendationRule[]
  deviceTokens        DeviceToken[]
  notifications       AppNotification[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

/// B2B wholesale business account (separate from retail browsing).
model BusinessProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopName])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which app registered this FCM token (gifts vs grocery).
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // android | ios | web
  /// customer = shopper apps; partner = merchant/delivery app.
  /// Keeps customer ORDER_UPDATE from alerting the partner app on the same account.
  clientApp String   @default("customer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, storeId])
  @@index([storeId])
  @@index([userId, storeId, clientApp])
}

model AppNotification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, storeId, createdAt])
  @@index([storeId, type, createdAt])
}

enum NotificationType {
  ORDER_PLACED
  ORDER_UPDATE
  PAYMENT
  REMINDER
  PROMO
  GENERAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time login codes sent via SMS Pasal. One active row per phone.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// Long-lived phone ↔ device trust so returning phones can skip OTP.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  /// Stable client-generated id for this install (UUID).
  deviceId   String
  /// sha256 of the secret device token stored on the phone.
  tokenHash  String
  platform   String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, phone])
  @@index([userId])
  @@index([phone])
  @@index([expiresAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  street    String
  apartment String?
  landmark  String?
  city      String
  state     String
  pincode   String
  latitude  Float
  longitude Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([userId])
}

/// Named group of hero banner slides. `sectionId` null on Banner = sticky header
/// carousel; a set sectionId places those slides in a reorderable feed block.
model BannerSection {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  /// Feed carousel height in logical pixels (header uses AppSettings heights).
  height    Int      @default(160)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  banners   Banner[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isActive])
  @@index([storeId, order])
}

/// Compact banner tile for the `miniBanners` home row, where several sit side
/// by side. Unlike `Banner` these carry no product strip — just an image that
/// deep-links to a product or category.
model MiniBanner {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  image     String
  /// Tap target kind: NONE, PRODUCT or CATEGORY.
  linkType  String   @default("NONE")
  /// Product id or category id, depending on linkType.
  linkId    String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, isActive])
  @@index([storeId, order])
}

model Banner {
  id         String         @id @default(cuid())
  storeId    String
  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Null = sticky home header carousel; otherwise a feed BannerSection.
  sectionId  String?
  section    BannerSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title      String
  subtitle   String?
  image      String
  link       String?
  /// Soft background tint for the app/home when this banner is active (hex, e.g. #FFE0E8).
  bgColor    String?
  /// Up to 3 product IDs shown in the banner strip (takes priority over category).
  productIds String[]       @default([])
  /// When set (and productIds empty), show up to 3 products from this category name.
  category   String?
  order      Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([storeId, isActive])
  @@index([storeId, order])
  @@index([sectionId, order])
}

model Product {
  id                        String               @id @default(cuid())
  storeId                   String
  store                     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                      String
  miniDescription           String?
  description               String
  category                  String
  price                     Float
  /// B2B / wholesale unit price for local businesses (null = not sold wholesale).
  wholesalePrice            Float?
  image                     String
  images                    String[]             @default([])
  variants                  Json[]               @default([])
  imageAlt                  String?
  isAvailable               Boolean              @default(true)
  showFoodTypeLabel         Boolean              @default(false)
  isVeg                     Boolean              @default(true)
  prepTime                  Int                  @default(15)
  tags                      String[]
  discount                  Float?               @default(0)
  /// Optional SKU — unique within a store when set.
  sku                       String?
  /// When true, stockQty is enforced for availability display.
  trackStock                Boolean              @default(false)
  /// Remaining units when trackStock is true (null = not tracked).
  stockQty                  Int?
  /// Pack size unit: kg, g, ml, l, piece, pack.
  unit                      String?
  /// Numeric pack size (e.g. 500 for 500g).
  unitValue                 Float?
  /// Grocery shelf / aisle label.
  aisle                     String?
  /// Customer may collect this product instead of paying for delivery.
  pickupEnabled             Boolean              @default(false)
  pickupLatitude            Float?
  pickupLongitude           Float?
  pickupAddress             String?
  sellerId                  String?
  seller                    Seller?              @relation(fields: [sellerId], references: [id])
  orderItems                OrderItem[]
  productViewEvents         ProductViewEvent[]
  sourceRecommendationRules RecommendationRule[] @relation("SourceProductRecommendationRules")
  targetRecommendationRules RecommendationRule[] @relation("TargetProductRecommendationRules")
  wishlistedBy              WishlistItem[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@unique([storeId, sku])
  @@index([storeId, category])
  @@index([storeId, isAvailable])
  @@index([sellerId])
}

/// Products a customer saved for later.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique
  storeId              String
  store                Store            @relation(fields: [storeId], references: [id])
  userId               String
  user                 User             @relation(fields: [userId], references: [id])
  items                OrderItem[]
  status               OrderStatus      @default(PENDING)
  /// PICKUP orders have no delivery address and never carry a delivery fee.
  fulfillmentType      FulfillmentType  @default(DELIVERY)
  pickupLatitude       Float?
  pickupLongitude      Float?
  pickupAddress        String?
  addressId            String?
  address              Address?         @relation(fields: [addressId], references: [id])
  deliveryPartnerId    String?
  deliveryPartner      DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  subtotal             Float
  deliveryFee          Float
  tax                  Float
  discount             Float            @default(0)
  couponDiscount       Float            @default(0)
  couponId             String?
  coupon               Coupon?          @relation(fields: [couponId], references: [id])
  /// Wallet balance applied to this order (already subtracted from `total`).
  walletDiscount       Float            @default(0)
  /// True once the wallet spend has actually been debited from the balance.
  walletDebited        Boolean          @default(false)
  /// Cashback earned by this order; credited to the wallet on delivery.
  cashbackAmount       Float            @default(0)
  cashbackStatus       CashbackStatus   @default(NONE)
  total                Float
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus    @default(PENDING)
  estimatedTime        Int
  placedAt             DateTime         @default(now())
  /// Start of the requested delivery window; null means deliver ASAP.
  scheduledFor         DateTime?
  /// Human-readable window shown to the customer, e.g. "Tomorrow, 12–3 PM".
  deliverySlotLabel    String?
  acceptedAt           DateTime?
  preparingAt          DateTime?
  outForDeliveryAt     DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  /// Customer shares this code with the rider/admin to confirm delivery.
  deliveryOtp          String?
  deliveryOtpCreatedAt DateTime?
  trackingUpdates      Json[]           @default([])
  isGift               Boolean          @default(false)
  /// Wholesale / B2B order (separate from retail storefront cart).
  isWholesale          Boolean          @default(false)
  businessName         String?
  recipientId          String?
  recipient            GiftRecipient?   @relation(fields: [recipientId], references: [id])
  occasionId           String?
  occasion             Occasion?        @relation(fields: [occasionId], references: [id])
  giftWrapId           String?
  giftWrap             GiftWrap?        @relation(fields: [giftWrapId], references: [id])
  greetingMessage      String?
  senderName           String?
  showSenderName       Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId])
  @@index([storeId, placedAt])
  @@index([status])
  @@index([status, deliveryPartnerId, storeId])
  @@index([orderNumber])
  @@index([couponId])
  @@index([isGift])
  @@index([isWholesale])
  @@index([scheduledFor])
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum CashbackStatus {
  NONE
  PENDING
  CREDITED
  VOIDED
}

enum WalletTxType {
  CASHBACK_PENDING
  CASHBACK_CREDIT
  CASHBACK_VOID
  REDEEM
  REDEEM_REFUND
  ADJUST
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  VOIDED
}

/// Spendable wallet balance per customer per storefront.
model WalletAccount {
  userId    String
  storeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, storeId])
  @@index([storeId])
}

/// Append-only wallet ledger. `amount` is signed: positive credits, negative debits.
model WalletTransaction {
  id           String         @id @default(cuid())
  userId       String
  storeId      String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId      String?
  type         WalletTxType
  amount       Float
  /// Balance after this entry settled; null while a cashback is still PENDING.
  balanceAfter Float?
  status       WalletTxStatus @default(COMPLETED)
  note         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([orderId, type])
  @@index([userId, storeId, createdAt])
  @@index([orderId])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponApplicability {
  ALL
  CATEGORIES
  PRODUCTS
}

model Coupon {
  id                    String              @id @default(cuid())
  storeId               String
  store                 Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code                  String
  description           String?
  type                  CouponType
  value                 Float
  minOrderAmount        Float               @default(0)
  maxDiscount           Float?
  usageLimit            Int?
  usedCount             Int                 @default(0)
  startAt               DateTime?
  endAt                 DateTime?
  isActive              Boolean             @default(true)
  applicability         CouponApplicability @default(ALL)
  applicableCategoryIds String[]            @default([])
  applicableProductIds  String[]            @default([])
  createdByUserId       String?
  createdBy             User?               @relation(fields: [createdByUserId], references: [id])
  orders                Order[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([storeId, code])
  @@index([storeId, isActive])
  @@index([createdByUserId])
}

/// One promo roulette play (limits spins + links awarded coupon).
model SpinPlay {
  id       String   @id @default(cuid())
  storeId  String
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId String?
  percent  Int
  playedAt DateTime @default(now())

  @@index([storeId, userId, playedAt])
}

/// Extra Promo-tab games (scratch, flip, lucky) — one play per game per UTC day.
model PromoGamePlay {
  id       String   @id @default(cuid())
  storeId  String
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// scratch | flip | lucky
  gameType String
  couponId String?
  percent  Int
  playedAt DateTime @default(now())

  @@index([storeId, userId, gameType, playedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model DeliveryPartner {
  id            String   @id @default(cuid())
  /// Linked User for partner-app phone OTP login. Legacy rows may be null.
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String   @unique
  email         String   @unique
  /// Optional for User-linked partners (OTP auth). Legacy rows may still have a hash.
  password      String?
  vehicleType   String   @default("bike")
  vehicleNumber String   @default("")
  isAvailable   Boolean  @default(false)
  currentLat    Float?
  currentLng    Float?
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isAvailable])
  @@index([userId])
}

/// Capability + store access for the merchant/delivery partner app.
model PartnerAccess {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerEnabled   Boolean  @default(false)
  deliveryEnabled Boolean  @default(false)
  /// Upaharo (gifts storefront)
  giftsEnabled    Boolean  @default(true)
  /// Grooll (grocery storefront)
  groceryEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([sellerEnabled])
  @@index([deliveryEnabled])
}

model Seller {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessAddress String
  gstin           String?   @unique
  phone           String
  email           String
  commission      Float     @default(15)
  bankAccountName String?
  bankAccountNo   String?
  ifscCode        String?
  panNumber       String?
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([isActive])
}

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY_PARTNER
  SELLER
}

model Category {
  id                  String               @id @default(cuid())
  storeId             String
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                String
  /// Short label for the mobile home header strip (e.g. "Dairy", "Snacks").
  shortName           String?
  image               String
  type                CategoryType         @default(PRODUCT)
  parentId            String?
  parent              Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            Category[]           @relation("CategoryHierarchy")
  recommendationRules RecommendationRule[] @relation("SourceCategoryRecommendationRules")
  isActive            Boolean              @default(true)
  /// Home header wash tint for this category, hex `#RRGGBB`.
  washColor           String?
  /// Mobile icon key (see ADMIN_CATEGORY_ICONS), e.g. `cake`.
  iconName            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([storeId, name, type])
  @@index([storeId, parentId])
  @@index([storeId, type])
}

enum CategoryType {
  PRODUCT
  RECIPIENT
  OCCASION
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum RecommendationScopeType {
  PRODUCT
  CATEGORY
}

enum RecommendationKind {
  RELATED
  ADDON
  COMBO
}

model GiftRecipient {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  relationship String
  birthDate    DateTime?
  anniversary  DateTime?
  interests    String[]
  notes        String?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model GiftWrap {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       Float
  image       String
  type        String
  isActive    Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())

  @@unique([storeId, name])
  @@index([storeId, type])
}

model Occasion {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  emoji       String
  description String
  icon        String
  isActive    Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model AppSettings {
  id                           String   @id @default(cuid())
  storeId                      String   @unique
  store                        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  siteName                     String   @default("Chapter Kurus")
  supportPhone                 String?
  supportEmail                 String?
  supportHours                 String?
  supportMessage               String?
  deliveryEstimate             String   @default("Estimated delivery: 20-30 minutes")
  deliveryNote                 String?
  /// Extra minutes added to delivery ETA while rain is detected (mobile).
  rainExtraMinutes             Int      @default(15)
  announcementText             String?
  storeAddress                 String?
  mapLatitude                  Float    @default(27.7172)
  mapLongitude                 Float    @default(85.3240)
  homepageShowBanner           Boolean  @default(true)
  /// Mobile homepage banner carousel height in logical pixels.
  homepageBannerHeight         Int      @default(320)
  /// Height of product tiles inside each homepage banner.
  homepageBannerProductHeight  Int      @default(112)
  /// Mini banner tiles visible per row (1-4); sets each tile's width.
  miniBannerColumns            Int      @default(3)
  /// Mini banner tile height in logical pixels.
  miniBannerHeight             Int      @default(96)
  homepageShowTopCategories    Boolean  @default(true)
  homepageShowCategorySections Boolean  @default(true)
  homepageShowOccasionTabs     Boolean  @default(true)
  homepageShowRecommendations  Boolean  @default(true)
  homepageShowValueDeals       Boolean  @default(true)
  /// Ordered product ids for the mobile Value Deals carousel. Empty = auto (discounted-first).
  valueDealsProductIds         String[] @default([])
  /// Header promo line, e.g. "Shop for ₹199 to unlock deals". Supports `{amount}`.
  valueDealsPromoText          String   @default("Shop for {amount} to unlock deals")
  /// Cart total needed to unlock Value Deals claims.
  valueDealsUnlockAmount       Float    @default(199)
  homepageShowSpinBanner       Boolean  @default(true)
  /// Gift wrapping, recipients and occasion selection at checkout.
  featureGiftOptions           Boolean  @default(true)
  /// AI shopping assistant entry points.
  featureAiAssistant           Boolean  @default(true)
  /// Save-for-later controls and account entry.
  featureWishlist              Boolean  @default(true)
  homepageRecommendationMode   String   @default("LATEST")
  homepageRecommendationTitle  String?
  /// Ordered mobile home sections: `[{ id, title, subtitle, visible }]`.
  homeSectionLayout            Json?
  /// Ordered category ids for the sticky home header. Empty = all PRODUCT (A–Z).
  headerCategoryIds            String[] @default([])
  /// Mobile brand primary (buttons / accents), hex `#RRGGBB`.
  brandPrimary                 String   @default("#8B5A2B")
  /// Mobile brand secondary (gold accents), hex `#RRGGBB`.
  brandSecondary               String   @default("#D4AF37")
  /// Home header soft wash fallback, hex `#RRGGBB`.
  headerWash                   String   @default("#F7F0E8")
  /// Scaffold / page background, hex `#RRGGBB`.
  pageBackground               String   @default("#FFFFFF")
  /// Primary text colour, hex `#RRGGBB`.
  textInk                      String   @default("#1F1F1F")
  /// Secondary / muted text colour, hex `#RRGGBB`.
  textMuted                    String   @default("#3E3E3E")
  /// Chip + image placeholder fill, hex `#RRGGBB`.
  surfaceSoft                  String   @default("#F4F4F5")
  /// Card / tile surface, hex `#RRGGBB`.
  cardBackground               String   @default("#FFFFFF")
  /// Card + input corner radius in logical pixels.
  cornerRadius                 Int      @default(12)
  /// Button corner radius in logical pixels.
  buttonRadius                 Int      @default(30)
  /// Spacing scale: COMPACT | COMFORTABLE | SPACIOUS.
  uiDensity                    String   @default("COMFORTABLE")
  /// Product grid columns on home / category tabs.
  productGridColumns           Int      @default(2)
  /// Product tile width-to-height ratio.
  productCardAspectRatio       Float    @default(0.68)
  productShowDiscountBadge     Boolean  @default(true)
  productShowCategoryLabel     Boolean  @default(false)
  /// Show the floating promo orb / Promo tab in the mobile bottom nav.
  showPromoTab                 Boolean  @default(true)
  /// Promo orb flip text, e.g. `20% OFF`.
  promoOrbLabel                String   @default("20% OFF")
  navHomeLabel                 String   @default("Home")
  navCategoriesLabel           String   @default("Categories")
  navTopPicksLabel             String   @default("Top picks")
  /// Master switch for the customer wallet + cashback programme.
  walletEnabled                Boolean  @default(false)
  /// Cashback earned per order, as a percent of the amount paid without wallet.
  cashbackPercent              Float    @default(0)
  /// Optional cap on cashback earned per order, in rupees.
  cashbackMaxAmount            Float?
  /// Share of an order that may be paid from the wallet.
  walletMaxPercentPerOrder     Float    @default(100)
  /// Optional cap on wallet spend per order, in rupees.
  walletMaxAmountPerOrder      Float?
  /// Lowest amount that must still be paid after wallet is applied (stops total at ₹0).
  checkoutMinPayable           Float    @default(0)
  /// Minimum goods total (items + gift wrap) required to place an order. 0 = no minimum.
  checkoutMinOrderAmount       Float    @default(0)
  /// Orders at or above this goods total get free delivery.
  freeDeliveryMinAmount        Float    @default(199)
  /// Delivery fee charged when the goods total is below freeDeliveryMinAmount.
  deliveryFeeAmount            Float    @default(40)
  /// Distance-based delivery zones from the store pin:
  /// `[{ id, maxRadiusKm, feeAmount, etaMinMinutes, etaMaxMinutes, label }]`.
  /// Null/empty = use flat deliveryFeeAmount only.
  deliveryRadiusTiers          Json?
  /// Polygon zones: `[{ id, label, feeAmount, etaMinMinutes, etaMaxMinutes, polygon:[{lat,lng}] }]`.
  /// When non-empty, replaces circle tiers for delivery matching.
  deliveryZones                Json?
  /// Bookable delivery windows: `[{ id, startHour, endHour, label }]` in Nepal
  /// time. Null = use built-in defaults; empty array = scheduling disabled.
  deliverySlots                Json?
  /// Quick day chips offered in the schedule picker, including today.
  scheduleDayCount             Int      @default(3)
  /// Furthest day a customer may book via the custom date picker.
  scheduleMaxDaysAhead         Int      @default(30)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model ProductViewEvent {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  viewedAt  DateTime @default(now())

  @@index([storeId, productId])
  @@index([storeId, userId, viewedAt])
  @@index([sessionId, viewedAt])
  @@index([viewedAt])
}

model RecommendationRule {
  id               String                  @id @default(cuid())
  storeId          String
  store            Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scopeType        RecommendationScopeType
  sourceProductId  String?
  sourceProduct    Product?                @relation("SourceProductRecommendationRules", fields: [sourceProductId], references: [id], onDelete: Cascade)
  sourceCategoryId String?
  sourceCategory   Category?               @relation("SourceCategoryRecommendationRules", fields: [sourceCategoryId], references: [id], onDelete: Cascade)
  targetProductId  String
  targetProduct    Product                 @relation("TargetProductRecommendationRules", fields: [targetProductId], references: [id], onDelete: Cascade)
  kind             RecommendationKind
  position         Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([storeId, scopeType, sourceProductId, kind, position])
  @@index([storeId, scopeType, sourceCategoryId, kind, position])
  @@index([storeId, targetProductId])
}
